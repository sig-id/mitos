{
  "profile": "agent-definition/v1",
  "id": "mitos.tester",
  "revision": 1,
  "name": "Tester",
  "description": "Design or execute focused checks for the assigned behavior and report reproducible evidence.",
  "kind": "worker",
  "match": {
    "use_for": [
      "Regression testing",
      "Reproducing failures",
      "Validation of a candidate change"
    ],
    "avoid_for": [
      "Treating an unrun test as success",
      "Changing acceptance criteria to make a failure disappear"
    ]
  },
  "instructions": {
    "path": "instructions.md",
    "sha256": "8657a39c7e2b417de3ce9c3d75330bf2084dee3a6aa2f28f9e713d1a0c2d4f62"
  },
  "runtime": {
    "requires": [
      "native_output",
      "tool_use"
    ],
    "preferences": []
  },
  "skills": [],
  "knowledge": [],
  "context": {
    "required": [
      "assignment",
      "constraints"
    ],
    "optional": [
      "project_context",
      "selected_artifacts",
      "prior_findings",
      "assignment_memory"
    ],
    "max_characters": 64000,
    "overflow": "summarize_optional"
  },
  "memory": {
    "scope": "assignment",
    "publication": "propose"
  },
  "capabilities": {
    "required": [
      "workspace.read",
      "command.run"
    ],
    "optional": [
      "workspace.write",
      "artifact.read",
      "artifact.write"
    ]
  },
  "limits": {
    "timeout_seconds": 1800,
    "max_turns": 80
  },
  "specialization": {
    "allow": [
      "name",
      "description",
      "instructions",
      "knowledge",
      "skills",
      "runtime.preferences",
      "runtime.requires",
      "context.optional",
      "context.required",
      "capabilities.required",
      "capabilities.optional",
      "limits"
    ],
    "required_capabilities": "retain",
    "optional_capabilities": "narrow",
    "max_instruction_bytes": 24000
  },
  "evidence": [
    "Commands, environment, input revision and observed outcomes",
    "Reproduction details for failures and explicit skipped coverage"
  ],
  "provenance": {
    "origin": "adapted",
    "source_project": "Chief Wiggum",
    "source_revision": "f11e476037819b9cd15ad00cc16bfd0956481aed",
    "source_paths": [
      "lib/agents/engineering/test-runner.md",
      "lib/agents/engineering/test-coverage.md"
    ],
    "license": "MIT"
  }
}
