{
  "profile": "agent-definition/v1",
  "id": "mitos.reviewer",
  "revision": 1,
  "name": "Reviewer",
  "description": "Independently assess a specific result against requirements and supporting evidence.",
  "kind": "worker",
  "match": {
    "use_for": [
      "Code or design review",
      "Spec-to-implementation assessment",
      "Checking evidence for an exact candidate result"
    ],
    "avoid_for": [
      "Style-only review without consequence",
      "Automatically fixing the result being reviewed"
    ]
  },
  "instructions": {
    "path": "instructions.md",
    "sha256": "7651f6b2f6afb42fcb3c21e66e7ca5cf37802a13d64a14b6b9177ca411f9dcd0"
  },
  "runtime": {
    "requires": [
      "native_output"
    ],
    "preferences": []
  },
  "skills": [],
  "knowledge": [],
  "context": {
    "required": [
      "assignment",
      "constraints"
    ],
    "optional": [
      "project_context",
      "selected_artifacts",
      "prior_findings",
      "assignment_memory"
    ],
    "max_characters": 64000,
    "overflow": "summarize_optional"
  },
  "memory": {
    "scope": "assignment",
    "publication": "propose"
  },
  "capabilities": {
    "required": [],
    "optional": [
      "workspace.read",
      "command.run",
      "artifact.read",
      "artifact.write"
    ]
  },
  "limits": {
    "timeout_seconds": 1800,
    "max_turns": 80
  },
  "specialization": {
    "allow": [
      "name",
      "description",
      "instructions",
      "knowledge",
      "skills",
      "runtime.preferences",
      "runtime.requires",
      "context.optional",
      "context.required",
      "capabilities.required",
      "capabilities.optional",
      "limits"
    ],
    "required_capabilities": "retain",
    "optional_capabilities": "narrow",
    "max_instruction_bytes": 24000
  },
  "evidence": [
    "Actionable findings tied to exact sources and candidate revision",
    "A clear account of coverage, uncertainty and unresolved concerns"
  ],
  "provenance": {
    "origin": "adapted",
    "source_project": "Chief Wiggum",
    "source_revision": "f11e476037819b9cd15ad00cc16bfd0956481aed",
    "source_paths": [
      "lib/agents/engineering/code-review.md",
      "lib/agents/engineering/validation-review.md"
    ],
    "license": "MIT"
  }
}
