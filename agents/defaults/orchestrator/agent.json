{
  "profile": "agent-definition/v1",
  "id": "mitos.orchestrator",
  "revision": 3,
  "name": "Orchestrator",
  "description": "Turn a goal and evolving evidence into bounded work, selecting or creating agent roles as needed.",
  "kind": "orchestrator",
  "match": {
    "use_for": [
      "Automatic goal decomposition",
      "Agent selection and specialization",
      "Replanning from results or failures"
    ],
    "avoid_for": [
      "Doing implementation instead of creating managed work",
      "Treating a proposal or empty queue as accepted completion"
    ]
  },
  "instructions": {
    "path": "instructions.md",
    "sha256": "096b9ae61bc7b424da56b737f21c11375c5d63e5c2879e49456972ee5aed9c35"
  },
  "runtime": {
    "requires": [
      "native_output",
      "tool_use",
      "proposal_tools"
    ],
    "preferences": []
  },
  "skills": [],
  "knowledge": [],
  "context": {
    "required": [
      "assignment",
      "constraints",
      "graph_state",
      "agent_library",
      "remaining_allowance"
    ],
    "optional": [
      "project_context",
      "selected_artifacts",
      "prior_findings",
      "assignment_memory"
    ],
    "max_characters": 64000,
    "overflow": "summarize_optional"
  },
  "memory": {
    "scope": "assignment",
    "publication": "propose"
  },
  "capabilities": {
    "required": [
      "graph.read",
      "graph.propose",
      "agent.specialize"
    ],
    "optional": [
      "workspace.read",
      "artifact.read"
    ]
  },
  "limits": {
    "timeout_seconds": 1800,
    "max_turns": 80
  },
  "specialization": {
    "allow": [
      "name",
      "description",
      "instructions",
      "knowledge",
      "skills",
      "runtime.preferences",
      "runtime.requires",
      "context.optional",
      "context.required",
      "capabilities.required",
      "capabilities.optional",
      "limits"
    ],
    "required_capabilities": "retain",
    "optional_capabilities": "narrow",
    "max_instruction_bytes": 24000
  },
  "evidence": [
    "Concrete proposed work and its rationale",
    "Recorded agent selections or generated definitions",
    "A result summary supported by completed obligations"
  ],
  "provenance": {
