{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["signal", "verdict", "summary", "selection", "findings", "stats"],
  "properties": {
    "signal": { "type": "string", "enum": ["pass", "fix"] },
    "verdict": { "type": "string", "enum": ["PASS", "FAIL"] },
    "summary": { "type": "string" },
    "selection": {
      "type": "object",
      "required": ["scope_type", "concern_type", "concern", "method"],
      "properties": {
        "scope_type": { "type": "string", "enum": ["global", "focused", "vertical"] },
        "scope_target": { "type": "string" },
        "vertical_path": { "type": "string" },
        "concern_type": { "type": "string", "enum": ["specific", "generic"] },
        "concern": { "type": "string" },
        "method": { "type": "string" }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "path", "issue", "fix"],
        "properties": {
          "id": { "type": "string" },
          "severity": { "type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"] },
          "path": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 },
          "code": { "type": "string" },
          "issue": { "type": "string" },
          "regression_test": { "type": "string" },
          "fix": { "type": "string" }
        }
      }
    },
    "stats": { "type": "object" },
    "dedupe_fingerprint": { "type": "string" }
  }
}
