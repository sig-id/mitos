{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["signal", "verdict", "summary"],
  "properties": {
    "signal": { "type": "string", "enum": ["pass", "skip", "fail"] },
    "verdict": { "type": "string", "enum": ["PASS", "SKIP", "FAIL"] },
    "summary": { "type": "string" },
    "branch": { "type": "string" },
    "commit_sha": { "type": "string" },
    "pushed": { "type": "boolean" },
    "error": { "type": "string" }
  }
}
