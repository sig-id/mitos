{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["signal", "verdict", "summary"],
  "properties": {
    "signal": { "type": "string", "enum": ["pass", "fail"] },
    "verdict": { "type": "string", "enum": ["PASS", "FAIL"] },
    "summary": { "type": "string" },
    "pr_url": { "type": "string" },
    "pr_number": { "type": "integer", "minimum": 0 },
    "error": { "type": "string" }
  }
}
