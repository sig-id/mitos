{
  "id": "autofix-loop",
  "scope": "project",
  "description": "The continuous autonomous-improvement daemon. Re-fires the autofix pipeline (random-audit -> verify-fix -> quality-gate -> commit-push -> open-pr) forever, each cycle in its own isolated workspace, up to max_instances in parallel.",
  "schedule": {
    "type": "continuous",
    "restart_delay_ms": 5000
  },
  "execution": {
    "type": "pipeline",
    "pipeline": "autofix"
  },
  "pool": "batch",
  "concurrency": {
    "max_instances": 4,
    "if_running": "queue",
    "queue_max": 16,
    "priority": 0
  },
  "restart": {
    "policy": "retry",
    "backoff": "exp",
    "max_attempts": 0
  },
  "health": {
    "type": "heartbeat",
    "interval_ms": 120000,
    "on_unhealthy": "restart"
  },
  "conditions": [
    { "type": "env_present", "name": "MITOS_GIT_REMOTE" }
  ],
  "execution_inputs": {
    "workspace": { "kind": "repo" },
    "parameters": {
      "severity_floor": "LOW",
      "dedupe_file": ".mitos/autofix-dedupe.json"
    }
  }
}
