{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mitos.local/schema/agent-runtime.schema.json",
  "title": "Mitos Agent Runtime Config",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "workspace", "sandbox", "providers", "policy", "watcher"],
  "properties": {
    "version": { "const": 1 },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "base_branch", "clean_before_run", "container_mount"],
      "properties": {
        "mode": { "const": "git-worktree" },
        "base_branch": { "type": "string", "minLength": 1 },
        "clean_before_run": { "type": "boolean" },
        "container_mount": { "const": "/workspace" }
      }
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend",
        "mode",
        "runtime",
        "network",
        "workdir",
        "home",
        "resources",
        "toolchain_rootfs",
        "credentials"
      ],
      "properties": {
        "backend": { "enum": ["none", "host-process", "nucleus", "remote", "vm"] },
        "mode": { "enum": ["none", "host-process", "strict-agent"] },
        "runtime": { "enum": ["none", "native", "gvisor"] },
        "network": { "enum": ["none", "host", "bridge"] },
        "workdir": { "const": "/workspace" },
        "home": { "const": "/home/agent" },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["memory", "cpus", "pids"],
          "properties": {
            "memory": { "type": "string", "minLength": 1 },
            "cpus": { "type": "integer", "minimum": 1 },
            "pids": { "type": "integer", "minimum": 1 }
          }
        },
        "toolchain_rootfs": { "type": "string", "minLength": 1 },
        "credentials": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pass_through"],
          "properties": {
            "pass_through": { "enum": ["explicit_only", "none", "inherit"] }
          }
        }
      }
    },
    "providers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["adapter_order"],
        "properties": {
          "adapter_order": {
            "type": "array",
            "minItems": 1,
            "items": { "enum": ["headless_json", "exec_json", "pty"] }
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "allow", "ask", "block"],
      "properties": {
        "default": { "enum": ["allow", "ask", "block"] },
        "allow": { "$ref": "#/$defs/policyRules" },
        "ask": { "$ref": "#/$defs/policyRules" },
        "block": { "$ref": "#/$defs/policyRules" }
      }
    },
    "watcher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "mode"],
      "properties": {
        "enabled": { "type": "boolean" },
        "mode": { "enum": ["local_only", "remote_approved_context"] },
        "model": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "policyRules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "maxProperties": 1,
        "properties": {
          "action": {
            "enum": [
              "read_workspace",
              "write_workspace",
              "run_tests",
              "install_package",
              "network_access",
              "git_push",
              "write_outside_workspace"
            ]
          },
          "command": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
